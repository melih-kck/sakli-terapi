{
  "name": "sakli-terapi",
  "private": true,
  "version": "1.0.0",
  "description": "Mahremiyet odaklı çevrim içi psikolojik destek deneyimini araştıran etkileşimli teknoloji prototipi.",
  "author": "Melih Küçük",
  "license": "UNLICENSED",
  "homepage": "https://sakli-terapi.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melih-kck/sakli-terapi.git"
  },
  "bugs": {
    "url": "https://github.com/melih-kck/sakli-terapi/issues"
  },
  "keywords": [
    "react",
    "vite",
    "supabase",
    "webrtc",
    "privacy",
    "prototype"
  ],
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "check:dead-code": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:accessibility": "npm run build && playwright test e2e/accessibility.spec.js --project=chromium-desktop --project=chromium-mobile",
    "test:e2e:cross-browser": "npm run build && playwright test e2e/demo.spec.js",
    "test:e2e:report": "playwright show-report",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "screenshots:portfolio": "node scripts/capture-portfolio-screenshots.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sentry/react": "^10.70.0",
    "@supabase/supabase-js": "^2.117.1",
    "peerjs": "^1.5.5",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
