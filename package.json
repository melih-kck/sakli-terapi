{
  "name": "sakli-terapi",
  "private": true,
  "version": "1.0.0",
  "description": "Mahremiyet odaklı çevrim içi psikolojik destek deneyimini araştıran etkileşimli ürün ve mühendislik portföyü.",
  "author": "Melih Küçük",
  "license": "UNLICENSED",
  "homepage": "https://sakli-terapi.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melih-kck/sakli-terapi.git"
  },
  "bugs": {
    "url": "https://github.com/melih-kck/sakli-terapi/issues"
  },
  "keywords": [
    "react",
    "vite",
    "supabase",
    "webrtc",
    "privacy",
    "portfolio"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "check:dead-code": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:accessibility": "npm run build && playwright test e2e/accessibility.spec.js --project=chromium-desktop --project=chromium-mobile",
    "test:e2e:cross-browser": "npm run build && playwright test e2e/demo.spec.js",
    "test:e2e:report": "playwright show-report",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "screenshots:portfolio": "node scripts/capture-portfolio-screenshots.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sentry/react": "^10.65.0",
    "@supabase/supabase-js": "^2.106.2",
    "peerjs": "^1.5.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "knip": "^6.31.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "qs": "^6.15.3",
    "uuid": "^11.1.1"
  }
}
